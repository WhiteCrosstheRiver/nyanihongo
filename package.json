{
  "name": "nyanihongo",
  "productName": "Nyanihongo",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A kawaii Japanese-learning app",
  "author": "Nyanihongo",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win",
    "dist:android": "npm run build && cap sync android && cd android && gradlew assembleDebug"
  },
  "devDependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@fontsource/zen-maru-gothic": "^5.3.1",
    "@tensorflow/tfjs": "^4.22.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "twemoji-colr-font": "^15.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "build": {
    "appId": "com.nyanihongo.app",
    "productName": "Nyanihongo",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Nyanihongo-Setup-${version}.exe"
    },
    "electronLanguages": [
      "en-US",
      "fr",
      "es",
      "zh-CN",
      "ja"
    ]
  }
}
